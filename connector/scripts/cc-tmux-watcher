#!/usr/bin/env python3
"""cc-tmux-watcher: poll CC's tmux pane, detect the idle state, fire wake.

This CC runs with --dangerously-skip-permissions, so it never shows a
permission prompt. Instead it sits idle at its prompt showing the
bypass-permissions indicator ("⏵⏵ bypass permissions"); while working it
shows "esc to interrupt". The watcher treats a sustained idle state as
"CC is waiting / may be stuck" and escalates.

Shots 1-4 nudge chat-Claude via the PC AHK channel (port 7777, configured
in /etc/weyland/wake.env) ONLY. The final shot (5) fires the PC channel AND
Pushcuts Julian — by then chat-Claude is unreachable. The 5-shot ladder, by
gap from the previous shot:

  Shot 1 (10s)  Shot 2 (+60s)  Shot 3 (+60s)  Shot 4 (+480s)  Shot 5 (+600s)

After shot 5 the cycle locks until CC leaves the idle state.

Stable hashing + 2-poll candidate debounce preserved from Atlas — these
are the engineering that makes the watcher reliable, not Atlas-specific.
"""
import hashlib
import json
import os
import subprocess
import time
import urllib.error
import urllib.request

PI_NAME = os.environ.get("WEYLAND_PI_NAME") or "minion"
PANE = os.environ.get("CC_WATCHER_PANE", f"{PI_NAME}:0")
MODE_FILE = "/etc/weyland/wake-mode"
PUSHCUT_ENV = "/etc/weyland/pushcut.env"
WAKE_ENV = "/etc/weyland/wake.env"
STATE_FILE = "/var/lib/weyland/tmux-watcher-state.json"
LOG = "/var/log/weyland-wake.log"

POLL_SEC = 3
# 5-shot escalation. Gap before shot 1 is INITIAL_DELAY_SEC; gaps before
# shots 2..5 are RETRY_SCHEDULE. Cadence: 10s, +60s, +60s, +480s, +600s.
INITIAL_DELAY_SEC = int(os.environ.get("CC_WATCHER_DELAY", "10"))
SHOT_GAPS_SEC = [
    int(os.environ.get("CC_WATCHER_SHOT2_GAP", "60")),
    int(os.environ.get("CC_WATCHER_SHOT3_GAP", "60")),
    int(os.environ.get("CC_WATCHER_SHOT4_GAP", "480")),
    int(os.environ.get("CC_WATCHER_SHOT5_GAP", "600")),
]
MAX_FIRES = 5
DEBOUNCE_POLLS = 2
CLEAR_DEBOUNCE = 2

RETRY_SCHEDULE = SHOT_GAPS_SEC

# This CC runs with --dangerously-skip-permissions: no permission prompts.
# It is idle (done, waiting for input) when the bypass-permissions indicator
# is present AND it is not actively working ("esc to interrupt").
PROMPT_MARKERS = [
    "⏵⏵ bypass permissions",
]
WORKING_MARKER = "esc to interrupt"

SHOT_MESSAGES = {
    1: "CC idle — standing by",
    2: "CC still idle (~1 min)",
    3: "CC still idle (~2 min)",
    4: "CC idle ~10 min — chat-Claude, confirm status",
    5: "Chat-Claude unresponsive — CC may be stuck (~20 min)",
}


def log(msg):
    ts = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    try:
        with open(LOG, "a") as f:
            f.write(f"{ts} {msg}\n")
    except OSError:
        pass


def read_kv(path, key):
    try:
        with open(path) as f:
            for line in f:
                if line.startswith(f"{key}="):
                    return line.split("=", 1)[1].strip().strip('"').strip("'")
    except Exception:
        return None
    return None


def read_mode():
    try:
        with open(MODE_FILE) as f:
            v = f.read().strip().lower()
    except Exception:
        v = ""
    return "off" if v == "off" else "on"


def read_state():
    try:
        with open(STATE_FILE) as f:
            s = json.load(f)
    except Exception:
        s = {}
    return {
        "pending_hash": s.get("pending_hash"),
        "pending_since": s.get("pending_since"),
        "last_fired_hash": s.get("last_fired_hash"),
        "fire_count": s.get("fire_count", 0),
        "last_fire_time": s.get("last_fire_time"),
        "candidate_hash": s.get("candidate_hash"),
        "candidate_count": s.get("candidate_count", 0),
    }


def write_state(s):
    try:
        os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
        with open(STATE_FILE, "w") as f:
            json.dump(s, f)
    except Exception as e:
        log(f"state-write-err err={type(e).__name__}")


def capture_pane():
    try:
        r = subprocess.run(
            ["tmux", "capture-pane", "-t", PANE, "-p"],
            capture_output=True, text=True, timeout=2,
        )
        return r.stdout if r.returncode == 0 else None
    except Exception:
        return None


def detect_prompt(text):
    """Return an idle-state block if CC is sitting idle at its prompt, else None.

    CC is idle when the bypass-permissions indicator is present and it is NOT
    actively working ("esc to interrupt"). The marker sits in the bottom
    status bar, so we grab the output above it for notification context."""
    if not text:
        return None
    if WORKING_MARKER in text:
        return None  # CC is working, not idle — don't wake
    for marker in PROMPT_MARKERS:
        if marker in text:
            idx = text.find(marker)
            return text[max(0, idx - 600):idx + 200]
    return None


def stable_signature(block):
    """Collapse the idle state to one stable signature.

    With --dangerously-skip-permissions there are no numbered options to
    parse; the idle screen is static, so a single constant signature is the
    most reliable anchor for the escalation ladder. Distinct idle periods are
    separated by working periods, which clear the watcher state."""
    if not block:
        return None
    for ln in block.splitlines():
        if any(m in ln for m in PROMPT_MARKERS):
            return "CC-IDLE-AT-PROMPT"
    return None


def fire_pushcut(shot, summary):
    secret = read_kv(PUSHCUT_ENV, "PUSHCUT_WEBHOOK_SECRET")
    if not secret:
        log(f"pushcut-no-secret shot={shot}")
        return
    url = f"https://api.pushcut.io/{secret}/notifications/CC_Needs_Julian"
    text = f"[{PI_NAME}] {SHOT_MESSAGES.get(shot, 'CC waiting')}: {summary[:120]}"
    body = json.dumps({"text": text[:200]}).encode()
    req = urllib.request.Request(
        url, data=body, method="POST",
        headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=5) as r:
            log(f"pushcut http={r.status} shot={shot}")
    except urllib.error.HTTPError as e:
        log(f"pushcut http={e.code} shot={shot}")
    except Exception as e:
        log(f"pushcut err={type(e).__name__} shot={shot}")


def fire_pc(shot, summary):
    url = read_kv(WAKE_ENV, "PC_WAKE_URL")
    token = read_kv(WAKE_ENV, "WAKE_TOKEN")
    if not url or not token:
        log(f"pc-wake-no-config shot={shot}")
        return
    text = f"[{PI_NAME}] {SHOT_MESSAGES.get(shot, 'CC waiting')}: {summary[:120]}"
    body = json.dumps({"shot": shot, "text": text[:200]}).encode()
    req = urllib.request.Request(
        url, data=body, method="POST",
        headers={"Content-Type": "application/json", "X-Wake-Token": token})
    try:
        with urllib.request.urlopen(req, timeout=5) as r:
            log(f"pc-wake http={r.status} shot={shot}")
    except urllib.error.HTTPError as e:
        log(f"pc-wake http={e.code} shot={shot}")
    except Exception as e:
        log(f"pc-wake err={type(e).__name__} shot={shot}")


def fire(block, shot):
    summary = block.strip().split("\n")[0][:160]
    mode = read_mode()
    if mode == "off":
        log(f"fire-skipped mode=off shot={shot}")
        return mode
    # Shots 1..4 nudge chat-Claude via the PC AHK channel only. Julian is
    # Pushcut only on the FINAL shot — once chat-Claude is unreachable.
    fire_pc(shot, summary)
    if shot >= MAX_FIRES:
        fire_pushcut(shot, summary)
    return mode


def main():
    log(f"watcher-start pi={PI_NAME} pane={PANE} initial_delay={INITIAL_DELAY_SEC} "
        f"shot_gaps={SHOT_GAPS_SEC} max_fires={MAX_FIRES} "
        f"debounce_polls={DEBOUNCE_POLLS}")
    no_marker_polls = 0
    while True:
        try:
            pane = capture_pane()
            block = detect_prompt(pane)
            sig = stable_signature(block) if block is not None else None
            state = read_state()
            pending_hash = state["pending_hash"]
            pending_since = state["pending_since"]
            last_fired_hash = state["last_fired_hash"]
            fire_count = state["fire_count"]
            last_fire_time = state["last_fire_time"]
            candidate_hash = state["candidate_hash"]
            candidate_count = state["candidate_count"]

            if sig is None:
                no_marker_polls += 1
                if no_marker_polls >= CLEAR_DEBOUNCE:
                    if pending_hash is not None:
                        log(f"pending-cleared hash={str(pending_hash)[:8]}")
                    if (pending_hash is not None or last_fired_hash is not None
                            or candidate_hash is not None):
                        write_state({"pending_hash": None, "pending_since": None,
                                     "last_fired_hash": None,
                                     "fire_count": 0, "last_fire_time": None,
                                     "candidate_hash": None,
                                     "candidate_count": 0})
                time.sleep(POLL_SEC)
                continue

            no_marker_polls = 0
            h = hashlib.sha256(sig.encode()).hexdigest()
            now = time.time()

            if h == last_fired_hash:
                idx = fire_count - 1
                interval = RETRY_SCHEDULE[idx] \
                    if 0 <= idx < len(RETRY_SCHEDULE) else RETRY_SCHEDULE[-1]
                if (fire_count < MAX_FIRES and last_fire_time is not None
                        and (now - last_fire_time) >= interval):
                    new_count = fire_count + 1
                    elapsed = int(now - last_fire_time)
                    mode = fire(block, new_count)
                    log(f"fire mode={mode} hash={h[:8]} shot={new_count} "
                        f"retry_after={elapsed}s")
                    write_state({"pending_hash": None, "pending_since": None,
                                 "last_fired_hash": h,
                                 "fire_count": new_count,
                                 "last_fire_time": now,
                                 "candidate_hash": None,
                                 "candidate_count": 0})
            elif h == pending_hash:
                if pending_since is not None and (now - pending_since) >= INITIAL_DELAY_SEC:
                    waited = int(now - pending_since)
                    mode = fire(block, 1)
                    log(f"fire mode={mode} hash={h[:8]} shot=1 waited={waited}s")
                    write_state({"pending_hash": None, "pending_since": None,
                                 "last_fired_hash": h,
                                 "fire_count": 1,
                                 "last_fire_time": now,
                                 "candidate_hash": None,
                                 "candidate_count": 0})
            elif h == candidate_hash:
                new_count = candidate_count + 1
                if new_count >= DEBOUNCE_POLLS:
                    log(f"pending-new hash={h[:8]}")
                    write_state({"pending_hash": h, "pending_since": now,
                                 "last_fired_hash": None,
                                 "fire_count": 0,
                                 "last_fire_time": None,
                                 "candidate_hash": None,
                                 "candidate_count": 0})
                else:
                    write_state({"pending_hash": pending_hash,
                                 "pending_since": pending_since,
                                 "last_fired_hash": last_fired_hash,
                                 "fire_count": fire_count,
                                 "last_fire_time": last_fire_time,
                                 "candidate_hash": h,
                                 "candidate_count": new_count})
            else:
                write_state({"pending_hash": pending_hash,
                             "pending_since": pending_since,
                             "last_fired_hash": last_fired_hash,
                             "fire_count": fire_count,
                             "last_fire_time": last_fire_time,
                             "candidate_hash": h,
                             "candidate_count": 1})

            time.sleep(POLL_SEC)
        except Exception as e:
            log(f"loop-err err={type(e).__name__}")
            time.sleep(POLL_SEC)


if __name__ == "__main__":
    main()
